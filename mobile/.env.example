# Mobile (Expo) environment variables
# Copy this file to .env and fill in values.
# Only EXPO_PUBLIC_* variables are available in the app; do not put secrets here.

# API base URL (backend)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Auth token storage key (optional; default used if unset)
EXPO_PUBLIC_AUTH_TOKEN_KEY=token_key

# Last online timestamp key
EXPO_PUBLIC_LAST_ONLINE_TIMESTAMP_KEY=last_online_timestamp

# Refresh token key
EXPO_PUBLIC_REFRESH_TOKEN_KEY=refresh_token